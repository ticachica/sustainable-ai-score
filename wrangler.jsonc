{
  // Cloudflare Worker for the SustainableAI Score dashboard.
  //
  // Files in this repo are served as static assets through the ASSETS
  // binding. src/worker.js answers requests that do not match a static file,
  // which is how GET /api/providers is served.
  //
  // The "name" must match the existing Worker in the Cloudflare dashboard,
  // otherwise a second Worker would be created instead of updating this one.
  "name": "sustainable-ai-score",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",

  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  }
}
